NODE_ENV=development
PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgresql://suitecrm:suitecrm@localhost:5433/suitecrm

# minimum 32 chars each — generate via `openssl rand -base64 48`
JWT_SECRET=dev-only-access-secret-change-me-min-32-characters-please
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-min-32-characters-please

# token lifetimes (seconds)
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

CORS_ORIGIN=http://localhost:5173
